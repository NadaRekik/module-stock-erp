  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="Retours" processRef="Process_1" />
  </bpmn:collaboration>
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_3" name="Système">
        <bpmn:flowNodeRef>StartEvent_s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_v</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_inf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_gen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_er</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_e</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_m</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_2" name="Responsable qualité">
        <bpmn:flowNodeRef>Gateway_g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_ctl</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_p2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_1" name="Magasinier">
        <bpmn:flowNodeRef>Activity_rec</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_p1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_s" name="Demande de retour reçue">
      <bpmn:outgoing>Flow_s_v</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_s" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="Activity_v" name="Vérifier la conformité du retour">
      <bpmn:incoming>Flow_s_v</bpmn:incoming>
      <bpmn:outgoing>Flow_v_g1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_g1" name="Retour accepté ?">
      <bpmn:incoming>Flow_v_g1</bpmn:incoming>
      <bpmn:outgoing>Flow_g1_inf</bpmn:outgoing>
      <bpmn:outgoing>Flow_g1_gen</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Activity_inf" name="Informer le demandeur du refus">
      <bpmn:incoming>Flow_g1_inf</bpmn:incoming>
      <bpmn:outgoing>Flow_inf_er</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Activity_gen" name="Générer le bon de retour">
      <bpmn:incoming>Flow_g1_gen</bpmn:incoming>
      <bpmn:outgoing>Flow_gen_rec</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_bon">
        <bpmn:targetRef>DataObjectReference_bon</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_g2" name="Articles en bon état ?">
      <bpmn:incoming>Flow_ctl_g2</bpmn:incoming>
      <bpmn:outgoing>Flow_g2_p1</bpmn:outgoing>
      <bpmn:outgoing>Flow_g2_p2</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Activity_rec" name="Réceptionner les articles retournés">
      <bpmn:incoming>Flow_gen_rec</bpmn:incoming>
      <bpmn:outgoing>Flow_rec_ctl</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="EndEvent_er" name="Retour refusé">
      <bpmn:incoming>Flow_inf_er</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Activity_ctl" name="Contrôler l&#39;état des articles">
      <bpmn:incoming>Flow_rec_ctl</bpmn:incoming>
      <bpmn:outgoing>Flow_ctl_g2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:subProcess id="Activity_p1" name="Mise en stock">
      <bpmn:incoming>Flow_g2_p1</bpmn:incoming>
      <bpmn:outgoing>Flow_p1_m</bpmn:outgoing>
      <bpmn:serviceTask id="Activity_a8" name="Calculer la capacité des emplacements disponibles">
        <bpmn:incoming>Flow_s_a8</bpmn:incoming>
        <bpmn:outgoing>Flow_a8_a9</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="Activity_a9" name="Proposer un emplacement de rangement">
        <bpmn:incoming>Flow_a8_a9</bpmn:incoming>
        <bpmn:incoming>Flow_gd_a9</bpmn:incoming>
        <bpmn:outgoing>Flow_a9_u4</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="Activity_u4" name="Ranger la marchandise à l&#39;emplacement proposé">
        <bpmn:incoming>Flow_a9_u4</bpmn:incoming>
        <bpmn:outgoing>Flow_u4_u5</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="Activity_u5" name="Confirmer l&#39;emplacement dans l&#39;application">
        <bpmn:incoming>Flow_u4_u5</bpmn:incoming>
        <bpmn:outgoing>Flow_u5_a10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="Activity_a10" name="Contrôler la capacité de l&#39;emplacement confirmé">
        <bpmn:incoming>Flow_u5_a10</bpmn:incoming>
        <bpmn:outgoing>Flow_a10_gk</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="Gateway_gk" name="Capacité respectée ?">
        <bpmn:incoming>Flow_a10_gk</bpmn:incoming>
        <bpmn:outgoing>Flow_gk_a11</bpmn:outgoing>
        <bpmn:outgoing>Flow_gk_u6</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="Activity_u6" name="Examiner la demande de dérogation de capacité">
        <bpmn:incoming>Flow_gk_u6</bpmn:incoming>
        <bpmn:outgoing>Flow_u6_gd</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="Gateway_gd" name="Dérogation accordée ?">
        <bpmn:incoming>Flow_u6_gd</bpmn:incoming>
        <bpmn:outgoing>Flow_gd_a9</bpmn:outgoing>
        <bpmn:outgoing>Flow_gd_a11</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="Activity_a11" name="Mettre à jour l&#39;emplacement du stock">
        <bpmn:incoming>Flow_gk_a11</bpmn:incoming>
        <bpmn:incoming>Flow_gd_a11</bpmn:incoming>
        <bpmn:outgoing>Flow_a11_a12</bpmn:outgoing>
        <bpmn:dataOutputAssociation id="DataOutputAssociation_ds1">
          <bpmn:targetRef>DataStoreReference_ds1</bpmn:targetRef>
        </bpmn:dataOutputAssociation>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="Activity_a12" name="Enregistrer le mouvement de stock (traçabilité)">
        <bpmn:incoming>Flow_a11_a12</bpmn:incoming>
        <bpmn:outgoing>Flow_a12_e</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="Event_1titprb" name="Marchandise mise en stock">
        <bpmn:incoming>Flow_a12_e</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:dataStoreReference id="DataStoreReference_ds1" name="Stock" />
      <bpmn:sequenceFlow id="Flow_s_a8" sourceRef="Event_1rvxq4l" targetRef="Activity_a8" />
      <bpmn:sequenceFlow id="Flow_a8_a9" sourceRef="Activity_a8" targetRef="Activity_a9" />
      <bpmn:sequenceFlow id="Flow_gd_a9" name="Non (réaffecter)" sourceRef="Gateway_gd" targetRef="Activity_a9" />
      <bpmn:sequenceFlow id="Flow_a9_u4" sourceRef="Activity_a9" targetRef="Activity_u4" />
      <bpmn:sequenceFlow id="Flow_u4_u5" sourceRef="Activity_u4" targetRef="Activity_u5" />
      <bpmn:sequenceFlow id="Flow_u5_a10" sourceRef="Activity_u5" targetRef="Activity_a10" />
      <bpmn:sequenceFlow id="Flow_a10_gk" sourceRef="Activity_a10" targetRef="Gateway_gk" />
      <bpmn:sequenceFlow id="Flow_gk_a11" name="Oui" sourceRef="Gateway_gk" targetRef="Activity_a11" />
      <bpmn:sequenceFlow id="Flow_gk_u6" name="Non" sourceRef="Gateway_gk" targetRef="Activity_u6" />
      <bpmn:sequenceFlow id="Flow_u6_gd" sourceRef="Activity_u6" targetRef="Gateway_gd" />
      <bpmn:sequenceFlow id="Flow_gd_a11" name="Oui" sourceRef="Gateway_gd" targetRef="Activity_a11" />
      <bpmn:sequenceFlow id="Flow_a11_a12" sourceRef="Activity_a11" targetRef="Activity_a12" />
      <bpmn:sequenceFlow id="Flow_a12_e" sourceRef="Activity_a12" targetRef="Event_1titprb" />
      <bpmn:startEvent id="Event_1rvxq4l" name="Marchandise reçue">
        <bpmn:outgoing>Flow_s_a8</bpmn:outgoing>
      </bpmn:startEvent>
