        <bpmn:outgoing>F15</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="End_Termine" name="Ajustement terminé">
        <bpmn:incoming>F15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:serviceTask id="Task_Notifier" name="Notifier le refus">
        <bpmn:incoming>F12</bpmn:incoming>
        <bpmn:outgoing>F16</bpmn:outgoing>
      </bpmn:serviceTask>
