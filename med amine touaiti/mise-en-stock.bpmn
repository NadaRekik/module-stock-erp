    <bpmn:sequenceFlow id="Flow_gk_a11" name="Oui" sourceRef="Gateway_gk" targetRef="Activity_a11" />
    <bpmn:sequenceFlow id="Flow_gk_u6" name="Non" sourceRef="Gateway_gk" targetRef="Activity_u6" />
    <bpmn:sequenceFlow id="Flow_u6_gd" sourceRef="Activity_u6" targetRef="Gateway_gd" />
    <bpmn:sequenceFlow id="Flow_gd_a11" name="Oui" sourceRef="Gateway_gd" targetRef="Activity_a11" />
    <bpmn:sequenceFlow id="Flow_a11_a12" sourceRef="Activity_a11" targetRef="Activity_a12" />
    <bpmn:sequenceFlow id="Flow_a12_e" sourceRef="Activity_a12" targetRef="EndEvent_e" />
  </bpmn:process>
