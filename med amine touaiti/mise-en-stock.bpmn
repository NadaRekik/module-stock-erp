<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_mise_en_stock" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.52.0">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="Mise en stock" processRef="Process_1" />
  </bpmn:collaboration>
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_3" name="Système">
        <bpmn:flowNodeRef>StartEvent_s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_a8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_a9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_a10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_gk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_a11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_a12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_e</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_2" name="Responsable stock">
        <bpmn:flowNodeRef>Activity_u6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_gd</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_1" name="Magasinier">
        <bpmn:flowNodeRef>Activity_u4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_u5</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_s" name="Marchandise reçue">
      <bpmn:outgoing>Flow_s_a8</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_s" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="Activity_a8" name="Calculer la capacité des emplacements disponibles">
      <bpmn:incoming>Flow_s_a8</bpmn:incoming>
      <bpmn:outgoing>Flow_a8_a9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Activity_a9" name="Proposer un emplacement de rangement">
      <bpmn:incoming>Flow_a8_a9</bpmn:incoming>
      <bpmn:incoming>Flow_gd_a9</bpmn:incoming>
      <bpmn:outgoing>Flow_a9_u4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Activity_u4" name="Ranger la marchandise à l&#39;emplacement proposé">
      <bpmn:incoming>Flow_a9_u4</bpmn:incoming>
      <bpmn:outgoing>Flow_u4_u5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Activity_u5" name="Confirmer l&#39;emplacement dans l&#39;application">
      <bpmn:incoming>Flow_u4_u5</bpmn:incoming>
      <bpmn:outgoing>Flow_u5_a10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Activity_a10" name="Contrôler la capacité de l&#39;emplacement confirmé">
      <bpmn:incoming>Flow_u5_a10</bpmn:incoming>
      <bpmn:outgoing>Flow_a10_gk</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_gk" name="Capacité respectée ?">
      <bpmn:incoming>Flow_a10_gk</bpmn:incoming>
      <bpmn:outgoing>Flow_gk_a11</bpmn:outgoing>
      <bpmn:outgoing>Flow_gk_u6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Activity_u6" name="Examiner la demande de dérogation de capacité">
      <bpmn:incoming>Flow_gk_u6</bpmn:incoming>
      <bpmn:outgoing>Flow_u6_gd</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_gd" name="Dérogation accordée ?">
      <bpmn:incoming>Flow_u6_gd</bpmn:incoming>
      <bpmn:outgoing>Flow_gd_a11</bpmn:outgoing>
      <bpmn:outgoing>Flow_gd_a9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Activity_a11" name="Mettre à jour l&#39;emplacement du stock">
      <bpmn:incoming>Flow_gk_a11</bpmn:incoming>
      <bpmn:incoming>Flow_gd_a11</bpmn:incoming>
      <bpmn:outgoing>Flow_a11_a12</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_ds1">
        <bpmn:targetRef>DataStoreReference_ds1</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Activity_a12" name="Enregistrer le mouvement de stock (traçabilité)">
      <bpmn:incoming>Flow_a11_a12</bpmn:incoming>
      <bpmn:outgoing>Flow_a12_e</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_e" name="Marchandise mise en stock">
      <bpmn:incoming>Flow_a12_e</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:dataStoreReference id="DataStoreReference_ds1" name="Stock" />
    <bpmn:sequenceFlow id="Flow_s_a8" sourceRef="StartEvent_s" targetRef="Activity_a8" />
    <bpmn:sequenceFlow id="Flow_a8_a9" sourceRef="Activity_a8" targetRef="Activity_a9" />
    <bpmn:sequenceFlow id="Flow_gd_a9" name="Non (réaffecter)" sourceRef="Gateway_gd" targetRef="Activity_a9" />
