<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_reception" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="Réception" processRef="Process_1" />
  </bpmn:collaboration>
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_1" name="Magasinier">
        <bpmn:flowNodeRef>Activity_t0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_gq</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_gc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_e1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_tl</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_2" name="Système">
        <bpmn:flowNodeRef>StartEvent_s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_a1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_gl</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_a2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_a3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_a4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_e2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_s" name="Livraison fournisseur reçue">
      <bpmn:outgoing>Flow_s_a1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_StartEvent_s" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="Activity_a1" name="Rapprocher l'avis d'expédition et la commande d'achat">
      <bpmn:incoming>Flow_s_a1</bpmn:incoming>
      <bpmn:outgoing>Flow_a1_t0</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Activity_t0" name="Compter la marchandise (quantité, état apparent)">
      <bpmn:incoming>Flow_a1_t0</bpmn:incoming>
      <bpmn:outgoing>Flow_t0_gq</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_gq" name="Contrôle qualité activé ?">
      <bpmn:incoming>Flow_t0_gq</bpmn:incoming>
      <bpmn:outgoing>Flow_gq_t1</bpmn:outgoing>
      <bpmn:outgoing>Flow_gq_gc</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Activity_t1" name="Effectuer le contrôle qualité">
      <bpmn:incoming>Flow_gq_t1</bpmn:incoming>
      <bpmn:outgoing>Flow_t1_gc</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_gc" name="Marchandise conforme ?">
      <bpmn:incoming>Flow_gq_gc</bpmn:incoming>
      <bpmn:incoming>Flow_t1_gc</bpmn:incoming>
      <bpmn:outgoing>Flow_gc_gl</bpmn:outgoing>
      <bpmn:outgoing>Flow_gc_t2</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Activity_t2" name="Déclarer l'écart de réception">
      <bpmn:incoming>Flow_gc_t2</bpmn:incoming>
      <bpmn:outgoing>Flow_t2_e1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="EndEvent_e1" name="Écart notifié au fournisseur">
      <bpmn:incoming>Flow_t2_e1</bpmn:incoming>
      <bpmn:messageEventDefinition id="MessageEventDefinition_EndEvent_e1" />
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Gateway_gl" name="Gestion par lots activée ?">
      <bpmn:incoming>Flow_gc_gl</bpmn:incoming>
      <bpmn:outgoing>Flow_gl_tl</bpmn:outgoing>
      <bpmn:outgoing>Flow_gl_a2</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Activity_tl" name="Saisir le numéro de lot et la date de péremption">
      <bpmn:incoming>Flow_gl_tl</bpmn:incoming>
      <bpmn:outgoing>Flow_tl_a2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Activity_a2" name="Générer le bon de réception">
      <bpmn:incoming>Flow_gl_a2</bpmn:incoming>
      <bpmn:incoming>Flow_tl_a2</bpmn:incoming>
      <bpmn:outgoing>Flow_a2_a3</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_bonrec">
        <bpmn:targetRef>DataObjectReference_bonrec</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Activity_a3" name="Enregistrer l'entrée en stock">
      <bpmn:incoming>Flow_a2_a3</bpmn:incoming>
      <bpmn:outgoing>Flow_a3_a4</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_ds1">
        <bpmn:targetRef>DataStoreReference_ds1</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Activity_a4" name="Notifier la comptabilité">
      <bpmn:incoming>Flow_a3_a4</bpmn:incoming>
      <bpmn:outgoing>Flow_a4_e2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_e2" name="Marchandise reçue">
      <bpmn:incoming>Flow_a4_e2</bpmn:incoming>
      <bpmn:messageEventDefinition id="MessageEventDefinition_EndEvent_e2" />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_s_a1" sourceRef="StartEvent_s" targetRef="Activity_a1" />
    <bpmn:sequenceFlow id="Flow_a1_t0" sourceRef="Activity_a1" targetRef="Activity_t0" />
    <bpmn:sequenceFlow id="Flow_t0_gq" sourceRef="Activity_t0" targetRef="Gateway_gq" />
    <bpmn:sequenceFlow id="Flow_gq_t1" name="Oui" sourceRef="Gateway_gq" targetRef="Activity_t1" />
    <bpmn:sequenceFlow id="Flow_gq_gc" name="Non" sourceRef="Gateway_gq" targetRef="Gateway_gc" />
    <bpmn:sequenceFlow id="Flow_t1_gc" sourceRef="Activity_t1" targetRef="Gateway_gc" />
    <bpmn:sequenceFlow id="Flow_gc_gl" name="Oui" sourceRef="Gateway_gc" targetRef="Gateway_gl" />
    <bpmn:sequenceFlow id="Flow_gc_t2" name="Non" sourceRef="Gateway_gc" targetRef="Activity_t2" />
    <bpmn:sequenceFlow id="Flow_t2_e1" sourceRef="Activity_t2" targetRef="EndEvent_e1" />
    <bpmn:sequenceFlow id="Flow_gl_tl" name="Oui" sourceRef="Gateway_gl" targetRef="Activity_tl" />
    <bpmn:sequenceFlow id="Flow_gl_a2" name="Non" sourceRef="Gateway_gl" targetRef="Activity_a2" />
    <bpmn:sequenceFlow id="Flow_tl_a2" sourceRef="Activity_tl" targetRef="Activity_a2" />
    <bpmn:sequenceFlow id="Flow_a2_a3" sourceRef="Activity_a2" targetRef="Activity_a3" />
    <bpmn:sequenceFlow id="Flow_a3_a4" sourceRef="Activity_a3" targetRef="Activity_a4" />
    <bpmn:sequenceFlow id="Flow_a4_e2" sourceRef="Activity_a4" targetRef="EndEvent_e2" />
    <bpmn:dataObject id="DataObject_bonrec" />
    <bpmn:dataObjectReference id="DataObjectReference_bonrec" name="Bon de réception" dataObjectRef="DataObject_bonrec" />
    <bpmn:dataStoreReference id="DataStoreReference_ds1" name="Stock" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="Participant_1_di" bpmnElement="Participant_1" isHorizontal="true">
        <dc:Bounds x="100" y="60" width="2240" height="360" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_1_di" bpmnElement="Lane_1" isHorizontal="true">
