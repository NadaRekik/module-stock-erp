      <bpmndi:BPMNShape id="EndEvent_e1_di" bpmnElement="EndEvent_e1">
        <dc:Bounds x="1340" y="112" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_gl_di" bpmnElement="Gateway_gl" isMarkerVisible="true">
        <dc:Bounds x="1010" y="245" width="50" height="50" />
