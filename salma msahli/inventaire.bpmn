    <bpmn:sequenceFlow id="Flow_g2_t3" name="Oui (recomptage)" sourceRef="Gateway_g2" targetRef="Activity_t3" />
    <bpmn:sequenceFlow id="Flow_t3_t4" sourceRef="Activity_t3" targetRef="Activity_t4" />
    <bpmn:sequenceFlow id="Flow_t4_g1" sourceRef="Activity_t4" targetRef="Gateway_g1" />
    <bpmn:sequenceFlow id="Flow_g1_g2" name="Oui" sourceRef="Gateway_g1" targetRef="Gateway_g2" />
    <bpmn:sequenceFlow id="Flow_g1_t6" name="Non" sourceRef="Gateway_g1" targetRef="Activity_t6" />
    <bpmn:sequenceFlow id="Flow_g2_t5" name="Non" sourceRef="Gateway_g2" targetRef="Activity_t5" />
    <bpmn:sequenceFlow id="Flow_t5_p" sourceRef="Activity_t5" targetRef="Activity_p" />
    <bpmn:sequenceFlow id="Flow_p_t6" sourceRef="Activity_p" targetRef="Activity_t6" />
    <bpmn:sequenceFlow id="Flow_t6_e" sourceRef="Activity_t6" targetRef="EndEvent_e" />
  </bpmn:process>
