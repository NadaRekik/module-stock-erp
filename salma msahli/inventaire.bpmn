<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_inventaire" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.52.0">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="Inventaire" processRef="Process_1" />
  </bpmn:collaboration>
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_3" name="Système">
        <bpmn:flowNodeRef>Activity_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_t6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_e</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_p</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_2" name="Responsable stock">
        <bpmn:flowNodeRef>StartEvent_s</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_t5</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_1" name="Magasinier">
        <bpmn:flowNodeRef>Activity_t3</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_s" name="Inventaire planifié ou demandé">
      <bpmn:outgoing>Flow_s_t1</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_s" />
    </bpmn:startEvent>
    <bpmn:userTask id="Activity_t1" name="Créer la session d&#39;inventaire">
      <bpmn:incoming>Flow_s_t1</bpmn:incoming>
      <bpmn:outgoing>Flow_t1_t2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Activity_t2" name="Figer les quantités théoriques et générer les fiches">
      <bpmn:incoming>Flow_t1_t2</bpmn:incoming>
      <bpmn:outgoing>Flow_t2_t3</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_fiche">
        <bpmn:targetRef>DataObjectReference_fiche</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:userTask id="Activity_t3" name="Saisir le comptage par emplacement">
      <bpmn:incoming>Flow_t2_t3</bpmn:incoming>
      <bpmn:incoming>Flow_g2_t3</bpmn:incoming>
      <bpmn:outgoing>Flow_t3_t4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Activity_t4" name="Calculer les écarts">
      <bpmn:incoming>Flow_t3_t4</bpmn:incoming>
      <bpmn:outgoing>Flow_t4_g1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_g1" name="Écart constaté ?">
      <bpmn:incoming>Flow_t4_g1</bpmn:incoming>
      <bpmn:outgoing>Flow_g1_g2</bpmn:outgoing>
      <bpmn:outgoing>Flow_g1_t6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_g2" name="Écart &#62; seuil ?">
      <bpmn:incoming>Flow_g1_g2</bpmn:incoming>
      <bpmn:outgoing>Flow_g2_t3</bpmn:outgoing>
      <bpmn:outgoing>Flow_g2_t5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Activity_t5" name="Valider les écarts">
      <bpmn:incoming>Flow_g2_t5</bpmn:incoming>
      <bpmn:outgoing>Flow_t5_p</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:subProcess id="Activity_p" name="Ajustement / casse / rebut">
      <bpmn:incoming>Flow_t5_p</bpmn:incoming>
      <bpmn:outgoing>Flow_p_t6</bpmn:outgoing>
      <bpmn:exclusiveGateway id="Gw_Validation" name="Validation requise ?">
        <bpmn:incoming>F6</bpmn:incoming>
        <bpmn:outgoing>F8</bpmn:outgoing>
        <bpmn:outgoing>F9</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="Task_MAJ" name="Mettre à jour le stock">
        <bpmn:incoming>F9</bpmn:incoming>
        <bpmn:incoming>F11</bpmn:incoming>
        <bpmn:outgoing>F13</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="Task_Compta" name="Transmettre la valorisation à la Comptabilité">
        <bpmn:incoming>F13</bpmn:incoming>
        <bpmn:outgoing>F14</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="Task_Histo" name="Enregistrer l’historique">
        <bpmn:incoming>F14</bpmn:incoming>
        <bpmn:outgoing>F15</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="End_Termine" name="Ajustement terminé">
        <bpmn:incoming>F15</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:serviceTask id="Task_Notifier" name="Notifier le refus">
        <bpmn:incoming>F12</bpmn:incoming>
        <bpmn:outgoing>F16</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="Task_HistoRefus" name="Enregistrer le refus dans l’historique">
        <bpmn:incoming>F16</bpmn:incoming>
        <bpmn:outgoing>F17</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:endEvent id="End_Refuse" name="Ajustement refusé">
        <bpmn:incoming>F17</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:userTask id="Task_Declarer" name="Déclarer écart, casse ou perte">
        <bpmn:incoming>Flow_06gtjqg</bpmn:incoming>
        <bpmn:incoming>F7</bpmn:incoming>
        <bpmn:outgoing>F4</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:serviceTask id="Task_Verifier" name="Vérifier motif et quantité">
        <bpmn:incoming>F4</bpmn:incoming>
        <bpmn:outgoing>F5</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="Gw_Donnees" name="Données valides ?">
        <bpmn:incoming>F5</bpmn:incoming>
        <bpmn:outgoing>F6</bpmn:outgoing>
        <bpmn:outgoing>F7</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="Task_Valider" name="Valider l’ajustement">
        <bpmn:incoming>F8</bpmn:incoming>
        <bpmn:outgoing>F10</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="Gw_Approuve" name="Ajustement approuvé ?">
        <bpmn:incoming>F10</bpmn:incoming>
        <bpmn:outgoing>F11</bpmn:outgoing>
        <bpmn:outgoing>F12</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:sequenceFlow id="F6" name="Oui" sourceRef="Gw_Donnees" targetRef="Gw_Validation" />
      <bpmn:sequenceFlow id="F8" name="Oui" sourceRef="Gw_Validation" targetRef="Task_Valider" />
      <bpmn:sequenceFlow id="F9" name="Non" sourceRef="Gw_Validation" targetRef="Task_MAJ" />
      <bpmn:sequenceFlow id="F11" name="Oui" sourceRef="Gw_Approuve" targetRef="Task_MAJ" />
      <bpmn:sequenceFlow id="F13" sourceRef="Task_MAJ" targetRef="Task_Compta" />
      <bpmn:sequenceFlow id="F14" sourceRef="Task_Compta" targetRef="Task_Histo" />
      <bpmn:sequenceFlow id="F15" sourceRef="Task_Histo" targetRef="End_Termine" />
      <bpmn:sequenceFlow id="F12" name="Non" sourceRef="Gw_Approuve" targetRef="Task_Notifier" />
      <bpmn:sequenceFlow id="F16" sourceRef="Task_Notifier" targetRef="Task_HistoRefus" />
      <bpmn:sequenceFlow id="F17" sourceRef="Task_HistoRefus" targetRef="End_Refuse" />
      <bpmn:sequenceFlow id="Flow_06gtjqg" sourceRef="Start_1" targetRef="Task_Declarer" />
      <bpmn:sequenceFlow id="F7" name="Non" sourceRef="Gw_Donnees" targetRef="Task_Declarer" />
      <bpmn:sequenceFlow id="F4" sourceRef="Task_Declarer" targetRef="Task_Verifier" />
      <bpmn:sequenceFlow id="F5" sourceRef="Task_Verifier" targetRef="Gw_Donnees" />
      <bpmn:sequenceFlow id="F10" sourceRef="Task_Valider" targetRef="Gw_Approuve" />
      <bpmn:startEvent id="Start_1" name="Demande d’ajustement reçue">
        <bpmn:outgoing>Flow_06gtjqg</bpmn:outgoing>
      </bpmn:startEvent>
    </bpmn:subProcess>
    <bpmn:serviceTask id="Activity_t6" name="Clôturer la session et débloquer les mouvements">
      <bpmn:incoming>Flow_g1_t6</bpmn:incoming>
      <bpmn:incoming>Flow_p_t6</bpmn:incoming>
      <bpmn:outgoing>Flow_t6_e</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_e" name="Inventaire clôturé">
      <bpmn:incoming>Flow_t6_e</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:dataObjectReference id="DataObjectReference_fiche" name="Fiche d&#39;inventaire" dataObjectRef="DataObject_fiche" />
    <bpmn:dataObject id="DataObject_fiche" />
    <bpmn:sequenceFlow id="Flow_s_t1" sourceRef="StartEvent_s" targetRef="Activity_t1" />
    <bpmn:sequenceFlow id="Flow_t1_t2" sourceRef="Activity_t1" targetRef="Activity_t2" />
