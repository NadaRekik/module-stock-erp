    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_g1" name="Valeur valide ?">
      <bpmn:incoming>Flow_t3_g1</bpmn:incoming>
      <bpmn:outgoing>Flow_g1_t5</bpmn:outgoing>
      <bpmn:outgoing>Flow_g1_t4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Activity_t5" name="Enregistrer le paramètre">
      <bpmn:incoming>Flow_g1_t5</bpmn:incoming>
      <bpmn:outgoing>Flow_t5_t6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Activity_1k8j0wg" name="Journaliser la modification.">
