      <bpmn:outgoing>Flow_1nskw97</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Activity_t3" name="Vérifier la valeur et sa cohérence">
      <bpmn:incoming>Flow_t2_t3</bpmn:incoming>
      <bpmn:outgoing>Flow_t3_g1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:subProcess id="Activity_p" name="Lots / péremption">
      <bpmn:incoming>Flow_g2_p</bpmn:incoming>
      <bpmn:outgoing>Flow_p_e</bpmn:outgoing>
